{
  "headers": [
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/explorer.html",
      "destination": "/transformer-explorer.html",
      "permanent": true
    },
    {
      "source": "/calculator.html",
      "destination": "/transformer-calculator.html",
      "permanent": true
    }
  ]
}